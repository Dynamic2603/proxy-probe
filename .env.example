# ==============================================================================
# proxy-probe (pxp) configuration template
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub Secret Gist Remote Sync (Zero-Server Subscription Delivery)
# ------------------------------------------------------------------------------
# ID of the Secret Gist used to publish proxy-ok.txt.
# Create once via GitHub CLI: gh gist create proxy-ok.txt --desc "Throne Proxy Pool"
#PROXY_PROBE_GIST_ID=your_32_char_gist_id_here

# Optional: GitHub Personal Access Token (PAT with 'gist' scope).
# If omitted, proxy-probe automatically obtains the token from `gh auth token`
# (no token configuration needed if GitHub CLI 'gh' is already logged in).
#GITHUB_TOKEN=ghp_your_token_here

# ------------------------------------------------------------------------------
# Antigravity CLI & Gemini Probing
# ------------------------------------------------------------------------------
# Path to the agy executable (defaults to autodiscovery in PATH / AppData).
#AGY_BIN=C:\Users\username\.gemini\antigravity-cli\agy.exe

# Model preference override for agy probing (e.g. gemini-2.5-flash, gemini-2.5-flash-lite).
# If omitted, proxy-probe automatically selects the lightest Flash model.
#AGY_MODEL=gemini-2.5-flash-lite

# ------------------------------------------------------------------------------
# Throne Directory & Engine Binaries
# ------------------------------------------------------------------------------
# Custom path to Throne data directory containing throne.db (defaults to AppData/Throne).
#THRONE_DIR=C:\Users\username\AppData\Roaming\Throne

# Custom directory for caching sing-box.exe and Xray.exe engines (defaults to bin/).
#PROXY_PROBE_BIN_DIR=C:\path\to\engines\bin
